# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "CLI task manager with markdown storage"
description:
  "Mark Task manages tasks in a CommonMark file with status, priority, categories, due dates, complexity and effort ratings, recurring tasks, search, undo/redo, and an interactive REPL."
maintainer: ["phillc73"]
authors: ["phillc73"]
license: "AGPL-3.0-only"
homepage: "https://github.com/phillc73/mark-task"
bug-reports: "https://github.com/phillc73/mark-task/issues"
depends: [
  "dune" {>= "3.1"}
  "cmdliner"
  "yojson"
  "uuidm"
  "ptime"
  "odoc"
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
